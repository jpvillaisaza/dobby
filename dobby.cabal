cabal-version: 3.8

name: dobby
version: 0.1.0.0

common common
  default-language: Haskell2010
  ghc-options: -Wall

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Dobby
  other-modules:
    Paths_dobby
  autogen-modules:
    Paths_dobby
  build-depends:
    , base >= 4.18.3 && < 4.19
    , http-client >= 0.7.19 && < 0.8
    , http-client-tls >= 0.3.6 && < 0.4
    , optparse-applicative >= 0.19.0 && < 0.20

executable dobby
  import: common
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    , base
    , dobby
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

test-suite dobby-test
  import: common
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    , base
    , dobby
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
