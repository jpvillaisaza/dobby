cabal-version: 3.8

name: dobby
version: 0.1.0.0

common common
  default-language: Haskell2010
  ghc-options: -Wall

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Dobby
  build-depends:
    , base >= 4.18.3 && < 4.19

executable dobby
  import: common
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    , base
    , dobby
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

test-suite dobby-test
  import: common
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    , base
    , dobby
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
